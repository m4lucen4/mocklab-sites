---
import type { HeaderSlide } from "../types";

interface Props {
  slide: HeaderSlide;
  logoUrl?: string | null;
  align: "center" | "left";
  buttonHtml: string;
}

const { slide, logoUrl, align, buttonHtml } = Astro.props;

const showLogo = !!(slide.show_logo && logoUrl);
const centerLogoTitle = showLogo && slide.logo_title_align === "center";
const wrapClass = align === "center" ? "text-center" : "max-w-lg";
const logoClass = align === "center" ? "h-10 md:h-14 w-auto mx-auto mb-4" : "h-10 md:h-14 w-auto mb-4";
---

<div
  class:list={[
    "relative z-10 flex flex-col h-full px-6 md:px-16 pb-12 md:pb-16",
    centerLogoTitle ? "" : "justify-end",
  ]}
>
  {centerLogoTitle ? (
    <>
      <div class:list={["flex-1 min-h-0 flex flex-col justify-center", wrapClass]}>
        <img src={logoUrl} alt="" class={logoClass} />
        <h1 class="text-sm md:text-base font-semibold tracking-[0.2em] text-white mb-3" style="font-family: var(--title-font);">{slide.title}</h1>
      </div>
      <div class={wrapClass}>
        <div class="text-sm md:text-base text-white/80 leading-relaxed mb-6 html-content" set:html={slide.description} />
        {slide.url_button && (
          <a
            href={slide.url_button}
            class:list={[
              "inline-flex items-center gap-2 px-6 py-2.5 bg-black/80 text-white text-sm font-medium rounded-full hover:bg-black transition-colors",
              !slide.text_button && slide.icon_button ? "justify-center" : "",
            ]}
            set:html={buttonHtml}
          />
        )}
      </div>
    </>
  ) : (
    <div class={wrapClass}>
      {showLogo && <img src={logoUrl} alt="" class={logoClass} />}
      <h1 class="text-sm md:text-base font-semibold tracking-[0.2em] text-white mb-3" style="font-family: var(--title-font);">{slide.title}</h1>
      <div class="text-sm md:text-base text-white/80 leading-relaxed mb-6 html-content" set:html={slide.description} />
      {slide.url_button && (
        <a
          href={slide.url_button}
          class:list={[
            "inline-flex items-center gap-2 px-6 py-2.5 bg-black/80 text-white text-sm font-medium rounded-full hover:bg-black transition-colors",
            !slide.text_button && slide.icon_button ? "justify-center" : "",
          ]}
          set:html={buttonHtml}
        />
      )}
    </div>
  )}
</div>

---
import { getSiteBySlug, getSitePages, getProjectListComponent, getUserProjects } from "../../../lib/supabase";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import LocalizedProjectDetail from "../../../components/LocalizedProjectDetail.astro";
import { normalizeSiteLanguages } from "../../../lib/siteLanguages";
import type { ProjectListConfig } from "../../../types";

const { slug, project: projectId } = Astro.params;

const site = await getSiteBySlug(slug!);

if (!site) {
  return Astro.redirect('/404');
}

const { defaultLanguage: language, enabledLanguages } = normalizeSiteLanguages(site);
const pages = await getSitePages(site.id);
const projectsPage = pages.find((page) => page.slug === "proyectos");

if (!projectsPage) {
  return Astro.redirect('/404');
}

const [projects, projectListComp] = await Promise.all([
  getUserProjects(site.user_id),
  getProjectListComponent(site.id),
]);

const project = projects.find((p) => String(p.id) === projectId);

if (!project) {
  return Astro.redirect('/404');
}

const detailType: 1 | 2 = ((projectListComp?.config as ProjectListConfig)?.detail_type ?? 1) as 1 | 2;
---

<BaseLayout site={site} pages={pages} currentPageSlug="proyectos">
  <LocalizedProjectDetail project={project} siteSlug={site.slug} detailType={detailType} fullWidth={!!site.full_width} language={language} languages={enabledLanguages} />
</BaseLayout>

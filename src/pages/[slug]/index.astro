---
import { getSiteBySlug, getSitePages, getPageComponents, getUserProjects } from "../../lib/supabase";
import type { SiteComponent, BodyConfig, EditorialCardsConfig, ProjectColumnsConfig, RichTextConfig, SeparatorConfig, FigureConfig, Project } from "../../types";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { normalizeSiteLanguages } from '../../lib/siteLanguages';
import Header from "../../components/Header.astro";
import { homeAnchorId } from '../../lib/siteNavigation';
import CTA from "../../components/CTA.astro";
import Body from "../../components/Body.astro";
import Content from "../../components/Content.astro";
import ProjectColumns from "../../components/ProjectColumns.astro";
import RichText from "../../components/RichText.astro";
import Figure from "../../components/Figure.astro";
import EditorialCards from "../../components/EditorialCards.astro";

const { slug } = Astro.params;

const site = await getSiteBySlug(slug!);

if (!site) {
  return Astro.redirect('/404');
}

const { defaultLanguage: language } = normalizeSiteLanguages(site);
const pages = await getSitePages(site.id);
const homePage = pages.find((p) => p.slug === "home" && p.page_type !== 'home_anchor');

let components: SiteComponent[] = [];
if (homePage) {
  components = await getPageComponents(homePage.id);
}

let allProjects: Project[] = [];
if (components.some((c) => c.type === "project_columns")) {
  allProjects = await getUserProjects(site.user_id);
}
---

<BaseLayout site={site} pages={pages} currentPageSlug="home" homeComponents={components}>
  {components.map((component) => {
    const block = (() => {
    if (component.type === "contact") {
      const config = (component.config || {}) as any;
      return <section data-component="contact" class="px-6 md:px-16 py-10 md:py-14">
        {config.antetitulo && <p class="text-xs font-semibold mb-3" style="color:var(--color-primary)">{config.antetitulo}</p>}
        {config.titulo && <h2 class="text-4xl font-bold mb-4" style="color:var(--color-primary);font-family:var(--title-font)">{config.titulo}</h2>}
        {config.descripcion && <div class="html-content" set:html={config.descripcion} />}
        {config.direccion1 && <div class="html-content" set:html={config.direccion1} />}
        {config.direccion2 && <div class="html-content" set:html={config.direccion2} />}
      </section>;
    }
    if (component.type === "header") {
      return <Header config={component.config as any} logoUrl={site.logo_url} language={language} />;
    }
    if (component.type === "cta") {
      return <CTA config={component.config as any} />;
    }
    if (component.type === "body") {
      return <Body config={component.config as BodyConfig} />;
    }
    if (component.type === "content") {
      return <Content config={component.config as any} primaryColor={site.primary_color} secondaryColor={site.secondary_color} />;
    }
    if (component.type === "editorial_cards") {
      return <EditorialCards config={component.config as EditorialCardsConfig} />;
    }
    if (component.type === "project_columns") {
      return <ProjectColumns config={component.config as ProjectColumnsConfig} projects={allProjects} siteSlug={site.slug} />;
    }
    if (component.type === "rich_text") {
      return <RichText config={component.config as RichTextConfig} />;
    }
    if (component.type === "separator") {
      const sizeMap = { small: "40px", medium: "80px", large: "128px" };
      const { size } = component.config as SeparatorConfig;
      return <div data-component="separator" style={`height:${sizeMap[size] ?? "80px"}`} />;
    }
    if (component.type === "figure") {
      return <Figure config={component.config as FigureConfig} />;
    }
    return null;
    })();
    const anchorId = homeAnchorId(component, homePage, components);
    return anchorId ? <div id={anchorId} data-home-anchor>{block}</div> : block;
  })}
</BaseLayout>
